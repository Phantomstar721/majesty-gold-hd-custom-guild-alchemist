// Invigorating Elixer follows Rage of Krolm's stock gameplay pattern. The
// runtime submits Majesty's deterministic Rage command only for CGBR; timed
// effectors own every unit's cleanup. The stock Krolm branch is preserved.

function Alchemist_Apply_Invigorating_Elixer(agent ThisAgent, string Family)
declare
	list Units;
	agent Unit;
begin
	$ListObjects(ThisAgent, Family, -1, Units, #MyPlayer, #InsideOtherUnits);
	foreach Unit in Units do
		begin
			if ($IsValidGamePiece(Unit))
				begin
					if ($CheckEffector(Unit, "alchemist_invigorating_elixer_icon") == False)
						begin
							$AdjustAttribute(Unit, #ATTRIB_MovementRateModifier, -200);
							$AdjustAttribute(Unit, #ATTRIB_MaxHP, 20);
							$AdjustAttribute(Unit, #ATTRIB_HP, 20);
							Unit's "Self_Estimation" += 1;
							$turnonSPeedTrail(Unit, 4);
							$CreateEffector(Unit, "alchemist_invigorating_elixer_icon", 30000);
						end
				end
		end
end

function Alchemist_Invigorating_Elixer_End(agent ThisAgent)
declare
	integer RestoredMaximum;
begin
	if ($IsValidGamePiece(ThisAgent))
		begin
			$AdjustAttribute(ThisAgent, #ATTRIB_MovementRateModifier, 200);
			$AdjustAttribute(ThisAgent, #ATTRIB_MaxHP, -20);
			ThisAgent's "Self_Estimation" -= 1;
			$turnoffSpeedTrail(ThisAgent);
			RestoredMaximum = $GetAttribute(ThisAgent, #ATTRIB_MaxHP);
			if ($GetAttribute(ThisAgent, #ATTRIB_HP) > $GetAttribute(ThisAgent, #ATTRIB_MaxHP))
				$SetAttribute(ThisAgent, #ATTRIB_HP, RestoredMaximum);
		end
end

function Alchemist_Stock_RageOfKrolm(agent ThisAgent)
declare
	list Heroes;
	agent Hero;
	agent Palace, AIRootAgent;
	integer HeroCount;
begin
	AIRootAgent = $RetrieveAgent("GplAIRoot");
	$ListObjects(ThisAgent, "hero", -1, Heroes, #MyPlayer, #InsideOtherUnits, #NoHiddenMap, #CheckSubtypes, "Hero");
	HeroCount = 0;
	foreach Hero in Heroes do
		begin
			if ($IsDead(Hero) == False)
				begin
					if ($HasAttribute("Deathmatch_Rules", AIRootAgent))
						if (AIRootAgent's "Deathmatch_Rules" == True)
							begin
								$CreateEffector(Hero, "Rage_Icon", #Deathmatch_Rage_Krolm_Duration);
								if (Hero's "Title" == "barbarian")
									$AdjustAttribute(Hero, #ATTRIB_Armor_Basic_Damage, #Deathmatch_Rage_Armor_Bonus);
							end
						else
							$CreateEffector(Hero, "Rage_Icon", #Rage_Krolm_Duration);
					else
						$CreateEffector(Hero, "Rage_Icon", #Rage_Krolm_Duration);
					$MagicalAdjustAttribute(Hero, #ATTRIB_Strength, #Rage_Strength_Boost);
					$MagicalAdjustAttribute(Hero, #ATTRIB_HtoH, #Rage_HtoH_Boost);
					$MagicalAdjustAttribute(Hero, #ATTRIB_Dodge, #Rage_Dodge_Boost);
					$MagicalAdjustAttribute(Hero, #ATTRIB_Parry, #Rage_Parry_Boost);
					$AdjustAttribute(Hero, #ATTRIB_MaxHP, #Rage_MaxHP_Boost);
					$AdjustAttribute(Hero, #ATTRIB_HP, #Rage_MaxHP_Boost);
					Hero's "Self_Estimation" += #Rage_Self_Est_Boost;
					$AdjustAttribute(Hero, #ATTRIB_MovementRateModifier, -200);
					$turnonSPeedTrail(Hero, 4);
					HeroCount += 1;
				end
		end
	Palace = $GetTruePalace(ThisAgent);
	$SetAttribute(Palace, #ATTRIB_RageOfKrolmCount, HeroCount);
	$PlaySound(ThisAgent, "Rage_of_Krolm", "begin");
end

function DoRageOfKrolm(agent ThisAgent)
declare
	agent Palace;
begin
	if (($HasAttribute("Alchemist_Brewing", ThisAgent)) &&
		(ThisAgent's "Alchemist_Brewing" == True))
		begin
			Palace = $GetTruePalace(ThisAgent);
			if ($GetPlayerData(Palace, "Gold") >= 1)
				begin
					$AdjustPlayerData(Palace, "Gold", -1);
					$PlaySound(ThisAgent, "alchemist_invigorating_elixer_sound", "Effector Begin");
					$Alchemist_Apply_Invigorating_Elixer(ThisAgent, "hero");
					$Alchemist_Apply_Invigorating_Elixer(ThisAgent, "monster");
				end
		end
	else
		$Alchemist_Stock_RageOfKrolm(ThisAgent);
end
