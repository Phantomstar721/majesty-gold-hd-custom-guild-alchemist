[AlchemistsLaboratory1]
	{Guild
		(type building)
		(subtype Guild)
		(title AlchemistsLaboratory)
		(Alchemist_Brewing True)
		(Visited_Script Alchemy_Lab_Visited)
		(Level 1)
		(member_title Alchemist)
		(member_basicscript Alchemist_tree)
		(max_members 4)
		(Lived_In_Script Alchemist_Lived_In)
		(Sleep_for 30000)
		(birthscript basic_birth)
		(birthScript2 Guild_Birth)
		(IGdeathscript guild_destroyed_a)
		(upgradescript basic_upgrade)
	}
[end]

