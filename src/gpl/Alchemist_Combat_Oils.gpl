///////////////////////////////////////////////////////////////////////////////
// Weapon Oil hit behavior. Stock damage dispatch calls these only after a
// confirmed hit, beside its untouched native WeaponPoisoned == 1 branch.
///////////////////////////////////////////////////////////////////////////////

expression #Alchemy_Paralytic_Duration 2000
expression #Alchemy_Paralytic_Immunity_Duration 10000
expression #Alchemy_Transmutation_Gold_Per_Hit 5

Function Alchemy_Paralytic_Oil_Begin (agent ThisAgent, agent Target)
Declare

Begin
	If ($IsDead (Target))
		Return;

	If ((Target's "Type" == "Building") || (Target's "Type" == "Lair"))
		Return;

	If ($HasAttribute ("Immune_to_poison", Target))
		If (Target's "Immune_to_poison" == True)
			Return;

	If ($GetAttribute (Target, #ATTRIB_HasEffectParalyticGaze) != 0)
		Return;

	// This private target-owned effector is shared by every hero carrying
	// Paralytic Oil. It gates only oil hits and is deliberately not consulted
	// by Stun Serum, Vines, Frost Armor, or any other control spell.
	If ($CheckEffector (Target, "alchemist_paralytic_oil_immunity"))
		Return;

	$CreateEffector (
		Target,
		"alchemist_paralytic_oil_immunity",
		#Alchemy_Paralytic_Immunity_Duration
	);
	$CreateEffector (
		Target,
		"alchemist_paralytic_oil_restraint",
		#Alchemy_Paralytic_Duration,
		"after"
	);
	$SetAttribute (Target, #ATTRIB_HasEffectParalyticGaze, 1);
	$Freeze_Unit (Target);
	$SpecifyIntent (Target, #intent_paralyized);
End


Function Alchemy_Paralytic_Oil_End (agent ThisAgent)
Declare

Begin
	$SetAttribute (ThisAgent, #ATTRIB_HasEffectParalyticGaze, 0);
	$UnFreeze_Unit (ThisAgent);
End


Function Alchemy_Paralytic_Oil_Immunity_End (agent ThisAgent)
Declare

Begin
End


Function Alchemy_Transmutation_Oil_Hit (agent ThisAgent, agent Target)
Declare

Begin
	// Stock Give_Gold owns both the hero-gold adjustment and floating feedback.
	$Give_Gold (ThisAgent, #Alchemy_Transmutation_Gold_Per_Hit);
End
