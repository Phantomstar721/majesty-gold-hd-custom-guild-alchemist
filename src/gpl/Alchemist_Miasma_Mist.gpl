///////////////////////////////////////////////////////////////////////////////
// Private Alchemist clone of stock Meteor Storm's stationary 21-second
// spell-unit lifecycle and the Haunt's Endless Winter presentation/penalties.
// The 175-radius pulse remains engine-scheduled every 1600 ms.  Each pulse
// deals one point of damage, matching one native poison tick, and refreshes a
// single 10-second enhanced-Chill-shaped debuff without stacking its stats.
///////////////////////////////////////////////////////////////////////////////

expression #Alchemist_Miasma_Mist_Radius 175
expression #Alchemist_Miasma_Mist_Debuff_Duration 10000

function Alchemist_Miasma_Mist_Check(agent ThisAgent) is integer

declare
	list Targets;
	agent Target;

begin
	If ($IsDead(ThisAgent))
		return 0;

	// Reject the current combat target before entering Meteor Storm's stock
	// list-size check.  This is the one private target rule: structures can
	// never prompt Miasma Mist even when another enemy happens to be nearby.
	Target = ThisAgent's "Target";
	If ($NotValid(Target))
		return 0;
	If ($IsDead(Target))
		return 0;
	If (Target's "Type" == "Building" || Target's "Type" == "Lair")
		return 0;

	// Literal Meteor_storm_check discovery, radius, list-size branch, and
	// return shape.  Do not return from inside a foreach here: the Beta2 GPL
	// interpreter leaves that function result slot unowned and crashes.
	Targets = $compile_enemies(ThisAgent, #Alchemist_Miasma_Mist_Radius);
	if ($ListSize(Targets) > 0)
		return 1;
	else
		return 0;
end


function Alchemist_Miasma_Mist_Hit(agent ThisAgent, agent Target)

declare

begin
	If ($Alchemist_Miasma_Mist_Check(ThisAgent) == 0)
		return;

	$PlaySound(ThisAgent, "Alchy_Cast", "Begin");
	$CreateSpellUnit(ThisAgent, "miasma_mist_cloud", Target);
end


function Alchemist_Miasma_Mist_Unit_Created(agent ThisAgent, agent Target)

declare
	integer Duration;

begin
	Duration = $GetSpellAttribute("miasma_mist", "effector_duration");
	$SetSpellUnitTimeout(ThisAgent, Duration);
	$CreateEffector(ThisAgent, "miasma_mist_cloud_effector", Duration);
	$NewThread(ThisAgent's "ActiveScript", 1600, ThisAgent);
	$Alchemist_Miasma_Mist_Active(ThisAgent);
end


function Alchemist_Miasma_Mist_Active(agent ThisAgent)

declare
	list Targets;
	agent Target;

begin
	If ($IsValidGamePiece(ThisAgent) == False)
		return;

	Targets = $compile_enemies(ThisAgent, #Alchemist_Miasma_Mist_Radius);
	foreach Target in Targets do
		If (Target's "Type" != "Building" && Target's "Type" != "Lair")
			$CreateMissile("miasma_mist_missile", ThisAgent, Target);
end


function Alchemist_Miasma_Mist_Missile_Hit(agent ThisAgent, agent Target)

declare

begin
	If ($IsDead(Target))
		return;
	If (Target's "Type" == "Building" || Target's "Type" == "Lair")
		return;

	// Native poison removes one HP each PeriodicHPDeltaPeriod.  Preserve that
	// exact low per-pulse damage rather than introducing a new damage roll.
	$player_spell_attack(Target, 1, 1);
	If ($IsDead(Target))
		return;

	$Alchemist_Miasma_Mist_Apply(Target);
end


function Alchemist_Miasma_Mist_Apply(agent Target)

declare

begin
	If ($HasAttribute("AlchemistMiasmaMistRemaining", Target) == False)
		begin
			$AddAttribute(
				Target,
				"AlchemistMiasmaMistRemaining",
				"integer",
				#Alchemist_Miasma_Mist_Debuff_Duration
			);
			$AddAttribute(Target, "AlchemistMiasmaMistActive", "boolean", False);
			$AddAttribute(
				Target,
				"AlchemistMiasmaMistWatch",
				"function",
				$Alchemist_Miasma_Mist_Watch
			);
		end

	If (Target's "AlchemistMiasmaMistActive" == False)
		begin
			Target's "AlchemistMiasmaMistActive" = True;
			$MagicalAdjustAttribute(Target, #ATTRIB_Dodge, -10);
			$MagicalAdjustAttribute(Target, #ATTRIB_Parry, -10);
			$AdjustAttribute(Target, #ATTRIB_MovementRateModifier, 100);
			$AdjustAttribute(Target, #ATTRIB_ActionRateModifier, 1000);
		end

	Target's "AlchemistMiasmaMistRemaining" =
		#Alchemist_Miasma_Mist_Debuff_Duration;

	If ($CheckEffector(Target, "miasma_mist_debuff_icon") == False)
		$CreateEffector(Target, "miasma_mist_debuff_icon", 1, "infinite");

	If ($IsRunning(Target's "AlchemistMiasmaMistWatch") == False)
		$NewThread(Target's "AlchemistMiasmaMistWatch", 100, Target);
end


function Alchemist_Miasma_Mist_Watch(agent ThisAgent)

declare

begin
	If ($IsValidGamePiece(ThisAgent) == False)
		return;

	If (ThisAgent's "AlchemistMiasmaMistActive" == False)
		begin
			$KillThread(ThisAgent's "AlchemistMiasmaMistWatch");
			return;
		end

	ThisAgent's "AlchemistMiasmaMistRemaining" -= 100;
	If (ThisAgent's "AlchemistMiasmaMistRemaining" > 0)
		return;

	$KillThread(ThisAgent's "AlchemistMiasmaMistWatch");
	ThisAgent's "AlchemistMiasmaMistActive" = False;
	$MagicalAdjustAttribute(ThisAgent, #ATTRIB_Dodge, 10);
	$MagicalAdjustAttribute(ThisAgent, #ATTRIB_Parry, 10);
	$AdjustAttribute(ThisAgent, #ATTRIB_MovementRateModifier, -100);
	$AdjustAttribute(ThisAgent, #ATTRIB_ActionRateModifier, -1000);
	If ($CheckEffector(ThisAgent, "miasma_mist_debuff_icon"))
		$DeleteEffector(ThisAgent, "miasma_mist_debuff_icon");
end
