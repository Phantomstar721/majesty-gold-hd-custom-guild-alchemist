///////////////////////////////////////////////////////////////////////////////
// Private Alchemist clone of stock OriginalQuests Rogue_tree.
// Ordering, calls, and flags are intentionally unchanged except for the
// requested deletion of Rogue's stealing and gravestone-looting branches.
// Nearby plant collection retains the stock Rogue/Ranger resource lifecycle.
///////////////////////////////////////////////////////////////////////////////

// Stock Vigilance uses -50 to produce a clearly faster movement profile.
expression #Alchemist_Base_Movement_Bonus -45
expression #Alchemist_Hire_Grant 100
// Match Call to Grave's accepted 500-unit minimum meaningful travel segment.
expression #Alchemist_Town_Shopping_Range 500
// A field Alchemist waits for a substantial purse before abandoning an
// expedition for the stock full-range equipment-shopping lifecycle.
expression #Alchemist_Funded_Resupply_Gold 2000
expression #Alchemist_Flash_Flask_Confidence 60
expression #Alchemist_Stun_Serum_Confidence 100
expression #Alchemist_Miasma_Mist_Confidence 30

// Misc Enhancements extends stock Hero with these exact fields and reads them
// directly from attackLogic. Install the same typed defaults when that Hero
// extension is absent, while keeping this Warrior-style dagger fighter opted
// out of kiting. Without the foreign combat routine the fields remain inert.
Function Alchemist_Sync_Kiting_Compatibility(agent ThisAgent)

Declare

Begin
	If ($HasAttribute("Should_Kite", ThisAgent) == False)
		$AddAttribute(ThisAgent, "Should_Kite", "boolean", False);
	Else
		ThisAgent's "Should_Kite" = False;

	If ($HasAttribute("KitingTime", ThisAgent) == False)
		$AddAttribute(ThisAgent, "KitingTime", "integer", 0);
End

Function Alchemist_Compat_Phantom_Max_Haunt_Level(agent ThisAgent) is integer

Declare
	list Haunts;
	agent Haunt;
	integer Best_Level;

Begin
	Best_Level = 0;
	$ListObjects(
		ThisAgent,
		"Building",
		-1,
		Haunts,
		#MyPlayer,
		#CheckTitles,
		"Phantoms_Haunt"
	);

	Foreach Haunt in Haunts do
		If ($IsDead(Haunt) == False)
			If ($GetAttribute(Haunt, #ATTRIB_CurrentStageBuilt) == 1)
				If (Haunt's "Level" > Best_Level)
					Best_Level = Haunt's "Level";

	return Best_Level;
End

// Literal clone of the Haunt's proven distinction between actual movement and
// the AI-facing speed rating. The boolean guard makes the additive modifier
// safe across repeated tree decisions and save/reload.
Function Alchemist_Sync_Speed_Profile(agent ThisAgent)

Declare

Begin
	If ($HasAttribute("AlchemistBaseMovementApplied", ThisAgent) == False)
		$AddAttribute(
			ThisAgent,
			"AlchemistBaseMovementApplied",
			"boolean",
			False
		);

	If (ThisAgent's "AlchemistBaseMovementApplied" == False)
		begin
			$AdjustAttribute(
				ThisAgent,
				#ATTRIB_MovementRateModifier,
				#Alchemist_Base_Movement_Bonus
			);
			ThisAgent's "AlchemistBaseMovementApplied" = True;
		end

	// This rating informs stock chase/escape evaluation; it does not move the
	// sprite. Two lies between Warrior 1 and Rogue 3.
	$SetAttribute(ThisAgent, #ATTRIB_Speed, 2);
End

Function Alchemist_birth(agent ThisAgent)

Declare
	agent Home;
	agent Palace;

Begin
	$hero_birth(ThisAgent);
	$Alchemist_Sync_Kiting_Compatibility(ThisAgent);
	// Stock hero_birth gives every hero 50-99 StoredGold. Add the fixed
	// Alchemist employment grant to that same stock-owned purse.
	$AdjustAttribute(
		ThisAgent,
		#ATTRIB_StoredGold,
		#Alchemist_Hire_Grant
	);
	Home = ThisAgent's "Home";
	If (
		$IsValidGamePiece(Home) &&
		$IsDead(Home) == False &&
		Home's "Type" == "Building" &&
		Home's "Title" == "AlchemistsLaboratory" &&
		$GetUnitPlayerNumber(ThisAgent) == $GetUnitPlayerNumber(Home)
	)
		If ($HasAttribute("AlchemistRecruitmentVoice", ThisAgent) == False)
			begin
				$AddAttribute(
					ThisAgent,
					"AlchemistRecruitmentVoice",
					"function",
					$Alchemist_Recruitment_Voice
				);
				If ($RandomNumber(100) + 1 <= 20)
					$RunThread(
						ThisAgent's "AlchemistRecruitmentVoice",
						250,
						ThisAgent
					);
			end
	Palace = $GetTruePalace(ThisAgent);
	If (
		$IsValidGamePiece(Palace) &&
		$GetAttribute(Palace, #ATTRIB_ResearchArrows) != 0
	)
		$Alchemist_Apply_Arcane_Infusion(ThisAgent);
	$Alchemist_Sync_Speed_Profile(ThisAgent);
End

Function Alchemist_Recruitment_Voice(agent ThisAgent)

Declare

Begin
	$PlaySound(ThisAgent, "Alchy_Hired", "Begin");
End

// Complete stock confidence function plus the two private guild branches.
// Keeping the stock and Phantom clauses makes either custom guild BCD safe to
// load last without deleting the other guild's target-evaluation weights.
function spell_extra_value(agent thisagent) is integer

declare
	integer value;

begin
	if ($isspellavailable(thisagent,"energy_blast",1))
		value += 10;

	if ($isspellavailable(thisagent,"fire_blast",1))
		value += 30;

	if ($isspellavailable(thisagent,"fire_ball",1))
		value += 30;

	if ($isspellavailable(thisagent,"teleport",1))
		value += 5;

	if ($isspellavailable(thisagent,"resist_magic",1))
		value += 5;

	if ($isspellavailable(thisagent,"meteor_storm",1))
		value += 30;

	if ($isspellavailable(thisagent,"drain_life",1))
		value += 30;

	if ($isspellavailable(thisagent,"sun_scorch",1))
		value += 30;

	if (thisagent's "Title" == "Phantom")
		begin
			if ($isspellavailable(thisagent,"ice_lance",1))
				value += 10;

			if ($isspellavailable(thisagent,"frost_armor",1))
				value += 10;

			if (
				$Alchemist_Compat_Phantom_Max_Haunt_Level(thisagent) >= 2 &&
				$isspellavailable(thisagent,"icy_touch",1)
			)
				value += 25;

			if ($isspellavailable(thisagent,"call_to_grave",1))
				value += 10;

			if ($isspellavailable(thisagent,"eternal_soul",1))
				value += 25;

			if (
				$Alchemist_Compat_Phantom_Max_Haunt_Level(thisagent) >= 3 &&
				$isspellavailable(thisagent,"endless_winter",1)
			)
				value += 30;
		end

	if (thisagent's "Title" == "Alchemist")
		begin
			if ($isspellavailable(thisagent,"flash_flask",1))
				value += #Alchemist_Flash_Flask_Confidence;

			if ($isspellavailable(thisagent,"stun_serum",1))
				value += #Alchemist_Stun_Serum_Confidence;

			if ($isspellavailable(thisagent,"miasma_mist",1))
				value += #Alchemist_Miasma_Mist_Confidence;
		end

	return value;
end

///////////////////////////////////////////////////////////////////////////////

function Alchemist_Collect_Nearby_Reagent (
	agent ThisAgent,
	string Resource,
	integer Chance
) is boolean

declare

begin
	// The stock resource callback increments num_picked_goodies. Do not dispatch
	// another pickup once the shared Alchemist load has reached its return limit.
	if (ThisAgent's "num_picked_goodies" >= #Alchemist_Reagent_Carry_Limit)
		return False;

	if ($Collect_Resource(ThisAgent, Resource, Chance) == False)
		return False;

	return True;
end

///////////////////////////////////////////////////////////////////////////////

function Alchemist_tree (agent thisagent)

declare

begin
	$Alchemist_Sync_Kiting_Compatibility(thisagent);
	$Alchemist_Sync_Speed_Profile(thisagent);

	$createeffector(thisagent,"thought_bubble_think",#think_bubble_time);
	$SpecifyIntent (ThisAgent, #Intent_Thinking);

	if ($check_nearby(thisagent) == False)

	// A full stock of three Reagents must be deposited before another bounty is
	// accepted. Stock Go_home still owns the 95% decision, travel, intent,
	// building entry, and reset lifecycle; an active combat or bounty is never
	// interrupted because this runs only when the ordinary tree is re-entered.
	if ($Alchemist_Return_Full_Reagent_Load(thisagent) == False)

	// Literal stock purchase clones restricted to the Call-to-Grave-derived
	// 500-unit town spacing let genuinely nearby shopping preempt a new flag.
	// The funded stock clone below permits one deliberate field resupply when a
	// wealthy Alchemist has an actual purchase available.
	if ($Alchemist_Purchase_Nearby_Equipment(thisagent) == False)

	if ($Alchemist_Purchase_Nearby_Bazaar(thisagent, 75) == False)

	if ($Alchemist_Funded_Resupply(thisagent) == False)

	if ($Check_rewards(thisagent,FALSE) == False)

	if ($Alchemist_Purchase_Bazaar(thisagent, 75) == False)

	if ($Defend_home(thisagent) == False)

	if ($defend_building(thisagent,"Gambling_hall") == FALSE)

	if ($rest(thisagent) == False)

	if ($Purchase_equipment(thisagent) == False)

	if ($pursue_entertainment(thisagent) == False)

	if ($collect_special_item (ThisAgent, 90) == False)

	// Literal stock Rogue poison-plant and Ranger healing-herb searches. Their
	// Basic_Pickup callback adds one item to the same carried Reagent count used
	// by monster remains, then deletes the collected map resource.
	if ($Alchemist_Collect_Nearby_Reagent(
		thisagent, "poison_plants", 90) == False)

	if ($Alchemist_Collect_Nearby_Reagent(
		thisagent, "healing_herbs", 95) == False)

	if ($check_library(thisagent,15, "Train_magic_resist") == FALSE)

	if ($check_library(thisagent,25, "Learn_generic_spell") == FALSE)

	if ($Combat_wandering(thisagent,65) == False)

	if ($combat_wandering_heroes(thisagent,55) == False)

	if ($Visit_Building(ThisAgent, "Inn", 35) == False)

	if	($explore_map(thisagent,20) == False)

	if ($Visit_Building(ThisAgent, "Royal_gardens", 30) == False)

	if ($Go_home(thisagent,95) == False)

		begin
			$SpecifyIntent (ThisAgent, #intent_wandering);
			thisagent's "counter" = 0;
			thisagent's "activescript" = $hero_wander;
		end

end

///////////////////////////////////////////////////////////////////////////////

function Alchemist_Return_Full_Reagent_Load(agent ThisAgent) is boolean

declare

begin
	if (ThisAgent's "num_picked_goodies" < 3)
		return False;

	if ($Go_home(ThisAgent,95) == False)
		return False;

	return True;
end
