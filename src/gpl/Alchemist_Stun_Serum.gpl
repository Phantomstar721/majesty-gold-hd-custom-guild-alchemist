///////////////////////////////////////////////////////////////////////////////
// Private clone of stock Paralytic Gaze, using the same Freeze_Unit /
// UnFreeze_Unit lifecycle as Vines. The visible restraint itself owns the
// duration and cleanup callback; stock Vines deliberately creates no icon.
///////////////////////////////////////////////////////////////////////////////

// Literal private clone of stock Multiple_Attack_Check. Stock uses this
// ValidationScript to keep an Attack spell out of $getbestspell when its
// current target is dead, a Building, or a Lair. The only requested change is
// using the Alchemist's established Rogue-range casting distance.
Function Alchemist_Stun_Serum_Check (agent ThisAgent) is integer
Declare
	agent Target;

Begin
	Target = ThisAgent's "Target";

	If ($IsDead (Target) == False)
		begin
			If (Target's "Type" != "Lair" && Target's "Type" != "Building")
				begin
					If ($DistanceBetweenAgents (ThisAgent, Target) <= ThisAgent's "castingrange")
						return 1;
				end
		end

	return 0;
End


///////////////////////////////////////////////////////////////////////////////

Function Alchemist_Stun_Serum_Begin (agent ThisAgent, agent Target)
Declare

Begin
	If ($IsDead (Target))
		Return;

	If ((Target's "Type" != "Building") && (Target's "Type" != "Lair"))
		begin
			$PlaySound (Target, "Alchy_Bottle", "Begin");
			$CreateEffector (Target, "alchemist_stun_serum_impact", 0);
			$CreateEffector (
				Target,
				"alchemist_stun_serum_restraint",
				$GetSpellAttribute ("stun_serum", "effector_duration"),
				"after"
			);
			$SetAttribute (Target, #ATTRIB_HasEffectParalyticGaze, 1);
			$Freeze_Unit (Target);
			$SpecifyIntent (Target, #intent_paralyized);
		end
End


Function Alchemist_Stun_Serum_End (agent ThisAgent)
Declare

Begin
	$SetAttribute (ThisAgent, #ATTRIB_HasEffectParalyticGaze, 0);
	$UnFreeze_Unit (ThisAgent);
End
