///////////////////////////////////////////////////////////////////////////////
// Alchemist Weapon Oil stock-mechanism proof
//
// Alchemy_Oil_Check is a private clone of stock WizGuild_Check. The candidate
// list is limited to completed Laboratories with Weapon Oil researched. The
// transaction stores one private persistent oil type beside Majesty's native
// poison and magical-enchantment fields. This preserves the stock rule that
// poison and Wizard enchanting are independent equipment properties.
///////////////////////////////////////////////////////////////////////////////

expression #Intent_Applying_Weapon_Oil 309
expression #Alchemy_Weapon_Oil_Price 100
expression #Alchemy_Transmutation_Greed 20
expression #Alchemy_Weapon_Oil_Task 1

Function Alchemy_Oil_Check (agent ThisAgent, list AlchemyLabs) is boolean
Declare
	agent	AlchemyLab;
	list	Potentials;
	integer Gold_Needed;

Begin
	If ($HasAttribute ("AlchemyWeaponOilType", ThisAgent))
		begin
			If (ThisAgent's "AlchemyWeaponOilType" > 0)
				begin
					$DebugOut ("My weapon already has an alchemical oil!");
					return False;
				end
		end

	Gold_Needed = #Alchemy_Weapon_Oil_Price;

	If ($Total_Gold (ThisAgent) < Gold_Needed)
		begin
			$DebugOut ("I can't afford an alchemical weapon oil!");
			return False;
		end

	If ($ListSize (AlchemyLabs) == 0)
		begin
			$DebugOut ("No researched Alchemy Labs within an Intel modified sightrange!");
			return False;
		end

	Foreach AlchemyLab in AlchemyLabs do
		begin
			If (AlchemyLab's "Level" > 0)
				Potentials << AlchemyLab;
		end

	If ($ListSize (Potentials) == 0)
		begin
			$DebugOut ("No Alchemy Labs can prepare weapon oil!");
			return False;
		end

	ThisAgent's "Task_Number" = #Alchemy_Weapon_Oil_Task;
	ThisAgent's "Target" = $Loyalty_Mod_Pick_Closest (ThisAgent, Potentials);
	$DebugOut ("I've got an Alchemy Lab to oil my weapon at!");
	ThisAgent's "TaskName" = "visiting";
	$SpecifyIntent (ThisAgent, #Intent_Applying_Weapon_Oil);
	return True;
End

///////////////////////////////////////////////////////////////////////////////
// Literal stock Enchant_Equipment entry lifecycle with a private callback.
///////////////////////////////////////////////////////////////////////////////

Function Alchemy_Oil_Enchant_Equipment (agent ThisAgent)
Declare

Begin
	$Enter_Building (ThisAgent, ThisAgent's "Target");

	$SetThreadInterval (ThisAgent's "ActiveScript", #Enchant_Equipment_Visit_Duration);

	ThisAgent's "ActiveScript" = $Obtain_Alchemy_Oil;

End

///////////////////////////////////////////////////////////////////////////////
// Stock Obtain_Enchantment's single level-1 purchase. One private integer
// stores the smallest payload required by the requested greed split.
///////////////////////////////////////////////////////////////////////////////

Function Obtain_Alchemy_Oil (agent ThisAgent)
Declare
	agent	ThisBuilding;
	integer	Total_Gold;
	integer	Gold;
	integer	Upgrade;

Begin
	ThisBuilding = ThisAgent's "Target";

	Total_Gold = $Total_Gold (ThisAgent);

	$SetThreadInterval (ThisAgent's "ActiveScript", #Normal_Cycle);

	If (Total_Gold >= #Alchemy_Weapon_Oil_Price)
		begin
			Total_Gold -= #Alchemy_Weapon_Oil_Price;
			Gold += #Alchemy_Weapon_Oil_Price;
			// Greed over 20 selects Transmutation Oil. This keeps Warriors,
			// Rangers, Barbarians, and Dwarves on Paralytic Oil while the
			// stock-greedy Elf/Rogue and greed-30 Alchemist transmute hits.
			If (ThisAgent's "Greed" > #Alchemy_Transmutation_Greed)
				begin
					Upgrade = 2;
				end
			Else
				begin
					Upgrade = 1;
				end
		end

	If (Upgrade > 0)
		begin
			If ($HasAttribute ("AlchemyWeaponOilType", ThisAgent) == False)
				$AddAttribute (
					ThisAgent,
					"AlchemyWeaponOilType",
					"integer",
					0
				);
			ThisAgent's "AlchemyWeaponOilType" = Upgrade;
			$Spend_Gold (ThisAgent, ThisBuilding, Gold);
			// Preserve the private coating type through the stock exit callback.
			ThisAgent's "Task_Number" = Upgrade;
			$DebugOut (ThisAgent's "Title","purchased alchemical weapon oil!");
		end

	ThisAgent's "ActiveScript" = $Alchemist_Done_Enhancing_Equipment;
End

///////////////////////////////////////////////////////////////////////////////
// Literal MX Done_Enhancing_Equipment lifecycle. The only private insertion is
// the post-exit stock Speed Tonic Enchantments presentation selected by the
// private coating value. NotVisibleInISOView prevents an overhead icon.
///////////////////////////////////////////////////////////////////////////////
Function Alchemist_Done_Enhancing_Equipment (agent ThisAgent)
Declare
	agent palace;

Begin
	$Exit_Building (ThisAgent, ThisAgent's "Target");

	If (ThisAgent's "Task_Number" == 1)
		$CreateEffector (
			ThisAgent,
			"alchemist_paralytic_weapon_oil_status",
			1,
			"Infinite"
		);
	Else If (ThisAgent's "Task_Number" == 2)
		$CreateEffector (
			ThisAgent,
			"alchemist_transmutation_weapon_oil_status",
			1,
			"Infinite"
		);

	if (ThisAgent's "Task_Number" == #ATTRIB_Armor_Struct_Bonus)
		$CreateEffector (ThisAgent, "got_armor", 0);
	else
		$CreateEffector (ThisAgent, "got_weapon", 0);

	palace = $GetTruePalace (ThisAgent);

	if ($IsValidGamePiece (palace))
		begin
			palace's "blacksmith_trips" += 1;
			if (palace's "blacksmith_trips" == #minotaur_blacksmith_limit)
				begin
					palace's "blacksmith_trips" = 0;
					$SpawnUnit (
						palace,
						"minotaur",
						$RandomEdgeCoord ($RandomNumber (4)),
						#Monster_Player
					);
				end
		end

	ThisAgent's "Task_Number" = 0;

	$Reset_Tasks (ThisAgent);
End
